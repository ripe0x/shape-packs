# Sepolia deploy target. Values only, no secrets; sourced by script/deploy.sh.
# Signing: set PRIVATE_KEY, or KEYSTORE_ACCOUNT (a name under ~/.foundry/keystores) in the shell.
# Source verification is a separate step and needs ETHERSCAN_API_KEY in the shell.

CHAIN_ID=11155111
RPC_DEFAULT=https://gateway.tenderly.co/public/sepolia
SIMULATED_SENDER_DEFAULT=0xcb43078c32423f5348cab5885911c3b5fae217f9
# This Foundry build simulates Cancun gas. Sepolia's Glamsterdam code-deposit repricing needs
# substantially more transaction gas; 1000% covers both creations with margin.
GAS_ESTIMATE_MULTIPLIER=1000

# The live Sepolia Shapes (web/public/deployment.sepolia.json in the Shapes repository).
SHAPES=0x6c2f9c00f44fbbf141dd166979903004b80d5f99

# Empty: the presentation admin defaults to the broadcaster. Set a multisig here for a launch.
ADMIN=
